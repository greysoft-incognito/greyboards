{
  "name": "greyboards",
  "private": true,
  "description": "Greyboards: billboards anywhere, booked online.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @greyboards/api dev",
    "dev:web": "pnpm --filter @greyboards/web dev",
    "dev:mobile": "pnpm --filter @greyboards/mobile start",
    "android:studio": "pnpm --filter @greyboards/mobile android:studio",
    "ark": "pnpm --filter @greyboards/api exec ark",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "railway": "3.16.0"
  }
}
