APP_NAME="Greyboards"
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:3000
APP_PORT=3000
APP_HOST=localhost
# Where files are stored. Use "local" in development and "s3" (any S3-compatible
# bucket, e.g. Cloudflare R2 or AWS S3) in production. Configured in src/config/filesystem.ts.
FILESYSTEM_DISK=local

CACHE_STORE=memory
QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

APP_KEY=
JWT_EXPIRES_IN=30d

NGROK_AUTHTOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxx

DATABASE_URL="postgres://postgres:postgres@localhost:5432/greyboards?schema=public"
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=greyboards
DB_USERNAME=postgres
DB_PASSWORD=postgres

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=password
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_TEST_ADDRESS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
# Disk for uploads (board photos, artwork, proof, avatars). Defaults to the local
# `public` disk, served by the API. In production use an S3-compatible bucket, e.g. UPLOADS_DISK=s3.
UPLOADS_DISK=

# Defaults for settings admins can change in the dashboard. A value saved there wins over these.
UPLOADS_MAX_IMAGE_MB=25
UPLOADS_MAX_AVATAR_MB=10
REGISTRATION_OPEN=true
SIGN_IN_MAX_ATTEMPTS=5
SIGN_IN_LOCKOUT_MINUTES=15
OWNER_SHARE_PERCENT=70
AGREEMENT_LINK_DAYS=14
BOOKING_COMMISSION_PERCENT=15
BOOKING_SCOUT_SHARE_PERCENT=30
BOOKING_HOLD_MINUTES=15
BOOKING_LEAD_DAYS=3
BOOKING_MAX_PERIODS=12
BOOKING_FULL_REFUND_DAYS=7
BOOKING_LATE_REFUND_PERCENT=50
PRINT_PRICE_PER_SQM=3500
PRINT_RESERVE_HOURS=2
PRINT_SEARCH_RADIUS_KM=25
PRINT_BY_DAYS=1
PRINT_RUSH_DAYS=3
PRINT_RUSH_BONUS_PERCENT=25
PRINT_MAX_MISSES=3
PRINT_MISS_WINDOW_DAYS=90
PROOF_MIN_PHOTOS=2
PROOF_MAX_DISTANCE_M=150
PROOF_ACCEPT_HOURS=48
PAYOUTS_ENABLED=false
PAYOUT_HOLD_DAYS=2
PAYOUT_COUNTRY=NG
PARTNERS_REQUIRE_ID=true
PARTNERS_REQUIRE_BANK=true
BOARD_DUPLICATE_RADIUS_M=30
# Bids and offers: open or sealed bids, the lowest reserve and raise, anti-sniping, time to pay, and offers.
BIDS_FORMAT=open
BIDS_MIN_RESERVE_PERCENT=100
BIDS_MIN_RAISE_PERCENT=5
BIDS_EXTEND_MINUTES=5
BIDS_MAX_OPEN_DAYS=30
BIDS_PAY_HOURS=24
OFFERS_MIN_PERCENT=50
OFFERS_REPLY_HOURS=48
# Shared (co-op) bookings: on or off, how many can split one, and how long they have to pay.
SHARED_BOOKINGS_ENABLED=true
SHARED_BOOKINGS_MAX_SHARES=6
SHARED_BOOKINGS_PAY_HOURS=48
SHARED_BOOKINGS_MERGE_LAYOUT=columns
# Messages about a booking: text managed owners each new message, and the longest message.
MESSAGES_SMS_OWNERS=true
MESSAGES_MAX_LENGTH=2000
# Reviews after a campaign: on or off, how long they stay open, and how many before an average shows.
REVIEWS_ENABLED=true
REVIEWS_WINDOW_DAYS=30
REVIEWS_MIN_TO_SHOW=3
# Disputes about a booking: on or off, how long after it ends one can be raised, how fast staff aim to decide, and whether one holds the money.
DISPUTES_ENABLED=true
DISPUTES_WINDOW_DAYS=14
DISPUTES_ANSWER_HOURS=48
DISPUTES_PAUSE_AUTO_ACCEPT=true
# Campaign reports: on or off, how many bookings each holds, and whether shared ones show spend.
REPORTS_ENABLED=true
REPORTS_MAX_BOOKINGS=20
REPORTS_SHOW_SPEND=false
# Scout pipeline: how close counts as the same board, how long a claim lasts, territories, and how far ahead the task list looks.
SCOUTING_CLAIM_RADIUS_M=50
SCOUTING_CLAIM_DAYS=30
SCOUTING_ENFORCE_TERRITORIES=false
SCOUTING_TASK_DAYS=7
# Seconds each API process keeps saved settings before reading them again.
SETTINGS_CACHE_SECONDS=60

# Proxies allowed to report the visitor's IP in X-Forwarded-For (rate limits key on it):
# a hop count such as 1, or their addresses/CIDRs. false trusts none.
TRUST_PROXY=false

# Payments for bookings. 'flutterwave', or 'fake' to approve every payment at once
# (never in production). Webhooks: POST /api/payments/flutterwave/webhook.
PAYMENT_DRIVER=flutterwave
PAYMENT_REFERENCE_PREFIX=gbd_
PAYMENT_RELAY_SECRET=
PAYMENT_RELAY_APP=greyboards
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
