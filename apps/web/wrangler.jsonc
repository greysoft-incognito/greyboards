{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "greyboards",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Variables live in the Cloudflare dashboard in production and in .dev.vars locally.
  "keep_vars": true,
  "env": {
    // Built with CLOUDFLARE_ENV=production by Cloudflare's Git builds.
    "production": {
      "name": "greyboards"
    }
  }
}
