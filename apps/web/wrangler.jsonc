{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "greyboards-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Variables live in the Cloudflare dashboard in production and in .dev.vars locally.
  "keep_vars": true,
  "env": {
    // Built with CLOUDFLARE_ENV=production by Cloudflare's Git builds.
    "production": {
      "name": "greyboards-web",
      // Previews of non-production branches use the staging API and OpenFreeMap's free tiles.
      "previews": {
        "vars": {
          "API_URL": "https://api.staging.greyboards.greysoft.com.ng/api",
          "MAP_STYLE_URL": "https://tiles.openfreemap.org/styles/positron"
        }
      }
    }
  }
}
