{
  "expo": {
    "name": "Greyboards",
    "slug": "greyboards",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.greysoft.greyboards.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F4F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.greysoft.greyboards.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "scheme": "greyboards",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Greyboards uses your location to place the boards you tag and to show they were photographed on site.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Greyboards uses the camera to photograph boards you tag.",
          "photosPermission": "Greyboards lets you pick photos for your profile and boards.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/splash-icon-ios.png",
          "imageWidth": 200,
          "backgroundColor": "#F4F4F5",
          "android": {
            "mdpi": "./assets/splash/splash-icon-mdpi.png",
            "hdpi": "./assets/splash/splash-icon-hdpi.png",
            "xhdpi": "./assets/splash/splash-icon-xhdpi.png",
            "xxhdpi": "./assets/splash/splash-icon-xxhdpi.png",
            "xxxhdpi": "./assets/splash/splash-icon-xxxhdpi.png"
          }
        }
      ],
      "./plugins/with-optional-features"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
